        {
          "value": "Daily",
          "label": "Daily"
        },
        {
          "value": "Weekly",
          "label": "Weekly"
        },
        {
          "value": "Monthly",
          "label": "Monthly"
        }
      ]
    },
    {
      "kind": "number",
      "key": "input@periods",
      "label": "Number of pivots back",
      "aliases": [
        "input#2",
        "number-of-pivots-back"
      ],
      "default": 15,
      "numericKind": "integer",
      "min": 1,
      "max": 40
