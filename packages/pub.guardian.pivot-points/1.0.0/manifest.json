  "type": "pub.guardian.pivot-points",
  "name": "Pivot Points Standard",
  "placement": "price",
  "apiVersion": 2,
  "gScriptVersion": 2,
  "version": "1.0.0",
  "creator": "guardian",
  "description": "Pivot, resistance and support levels from the previous day, week or month, drawn for each period in six classic styles",
  "changelog": "Initial release.",
  "requires": {
    "timeframes": [
      {
        "timeframe": "1D"
