{
  "type": "pub.guardian.supertrend",
  "name": "Supertrend",
  "placement": "price",
  "apiVersion": 2,
  "gScriptVersion": 2,
  "version": "1.0.0",
  "creator": "guardian",
  "description": "An ATR-based trailing line that sits below price in an up trend and above it in a down trend, with flip signals",
  "changelog": "Initial release.",
  "inputs": [
    {
      "kind": "number",
      "key": "input@atr-length",
      "label": "ATR length",
      "aliases": [
        "input#0",
        "atr-length"
      ],
      "default": 10,
      "numericKind": "integer",
      "min": 1,
      "max": 200
    },
    {
      "kind": "number",
      "key": "input@factor",
      "label": "Factor",
      "aliases": [
        "input#1",
        "factor"
      ],
      "default": 3,
      "numericKind": "float",
      "min": 0.1,
      "step": 0.1
    },
    {
      "kind": "toggle",
      "key": "input@signals",
      "label": "Show buy/sell signals",
      "aliases": [
        "input#2",
        "show-buy-sell-signals"
      ],
      "default": true
    },
    {
      "kind": "toggle",
      "key": "input@shade",
      "label": "Shade the trend",
      "aliases": [
        "input#3",
        "shade-the-trend"
      ],
      "default": true
    },
    {
      "kind": "color",
      "key": "input@up-color",
      "label": "Up trend",
      "aliases": [
        "input#4",
        "up-trend"
      ],
      "default": "#26a69a"
