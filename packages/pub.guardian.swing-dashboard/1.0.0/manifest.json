{
  "type": "pub.guardian.swing-dashboard",
  "name": "Swing Dashboard",
  "placement": "price",
  "apiVersion": 2,
  "gScriptVersion": 2,
  "version": "1.0.0",
  "creator": "guardian",
  "description": "One compact table of the numbers a swing trader checks first: range, volatility, volume, liquidity, trend and strength",
  "changelog": "Initial release.",
  "requires": {
    "symbols": [
      {
        "symbol": "NIFTY",
        "exchange": "INDEX"
      }
    ]
  },
  "inputs": [
    {
      "kind": "string",
      "key": "input@benchmark",
      "label": "Benchmark",
      "aliases": [
        "input#0",
        "benchmark"
      ],
      "default": "INDEX:NIFTY",
      "control": "symbol"
    },
    {
      "kind": "select",
      "key": "input@position",
      "label": "Position",
      "aliases": [
        "input#1",
        "position"
      ],
      "default": "Top right",
      "options": [
        {
          "value": "Top right",
          "label": "Top right"
        },
        {
          "value": "Top left",
          "label": "Top left"
        },
        {
          "value": "Bottom right",
          "label": "Bottom right"
        },
        {
          "value": "Bottom left",
          "label": "Bottom left"
        }
      ]
    },
    {
      "kind": "number",
      "key": "input@adr-length",
      "label": "ADR length",
      "aliases": [
        "input#2",
        "adr-length"
      ],
      "default": 20,
      "numericKind": "integer",
      "min": 1,
      "max": 200
    },
    {
      "kind": "number",
      "key": "input@atr-length",
      "label": "ATR length",
      "aliases": [
        "input#3",
        "atr-length"
      ],
      "default": 14,
      "numericKind": "integer",
      "min": 1,
      "max": 200
    },
    {
      "kind": "number",
      "key": "input@volume-length",
      "label": "Volume average length",
      "aliases": [
        "input#4",
        "volume-average-length"
      ],
      "default": 50,
      "numericKind": "integer",
      "min": 2,
      "max": 500
    },
    {
      "kind": "number",
      "key": "input@min-adr",
      "label": "Minimum ADR%",
      "aliases": [
        "input#5",
        "minimum-adr"
      ],
      "default": 3.5,
      "numericKind": "float",
      "min": 0,
      "step": 0.5
    },
    {
      "kind": "number",
      "key": "input@min-turnover",
      "label": "Minimum turnover (₹ Cr)",
      "aliases": [
        "input#6",
        "minimum-turnover-cr"
      ],
      "default": 10,
      "numericKind": "float",
      "min": 0,
      "step": 1
    },
    {
      "kind": "number",
      "key": "input@surge-at",
      "label": "Volume surge at (× average)",
      "aliases": [
        "input#7",
        "volume-surge-at-average"
      ],
      "default": 1.5,
      "numericKind": "float",
      "min": 1,
      "step": 0.1
    },
    {
      "kind": "number",
      "key": "input@dry-up-at",
      "label": "Volume dry-up at (× average)",
      "aliases": [
        "input#8",
        "volume-dry-up-at-average"
      ],
      "default": 0.5,
      "numericKind": "float",
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "kind": "color",
      "key": "input@up-color",
      "label": "Good",
      "aliases": [
        "input#9",
        "good"
      ],
      "default": "#26a69a"
    },
    {
      "kind": "color",
      "key": "input@down-color",
      "label": "Poor",
      "aliases": [
        "input#10",
        "poor"
      ],
      "default": "#ef5350"
    },
    {
      "kind": "color",
      "key": "input@surge-color",
      "label": "Volume surge",
      "aliases": [
        "input#11",
        "volume-surge"
      ],
      "default": "#f59e0b"
    },
    {
      "kind": "color",
      "key": "input@dry-up-color",
      "label": "Volume dry-up",
      "aliases": [
        "input#12",
        "volume-dry-up"
      ],
      "default": "#38bdf8"
    }
  ],
  "outputContract": {
    "schemaVersion": 1,
    "adapter": "pine-event-v2",
    "mode": "native-event",
    "gScriptVersion": 2,
    "outputSemantics": {
      "id": "g-script-v2",
      "limits": {
        "maxPrecision": 8,
        "maxShowLastBars": 50000,
        "maxOffsetBars": 500
      }
    },
    "outputWireVersion": 2,
    "planSchemaVersion": 1,
    "declarationFingerprint": "pine-event-declarations/v1/1e214f77861229b0",
