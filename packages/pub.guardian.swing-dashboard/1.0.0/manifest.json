    "alertConditions": [
      {
        "id": "quiet-accumulation",
        "title": "Quiet accumulation",
        "message": "Volume dry-up at or below the Volume dry-up threshold, with up/down volume at or above 1"
      },
      {
        "id": "volume-surge",
        "title": "Volume surge",
        "message": "RVOL reached the Volume surge at threshold"
      }
    ],
